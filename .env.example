# Supabase project settings (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key

# Comma-separated Google emails that receive Owner permissions and GLB download access.
SUPABASE_ADMIN_EMAILS=milanbpatel90@gmail.com,milan.patel90@yahoo.com

# Set true in production (Railway HTTPS).
AUTH_COOKIE_SECURE=false  # Set true on Railway/production HTTPS

# Leave blank when the browser viewer and API are served from the same origin.
CORS_ALLOWED_ORIGINS=

# Wasabi private S3-compatible storage (set these in Railway backend variables)
WASABI_BUCKET=your-private-bucket-name
WASABI_REGION=ap-southeast-1
WASABI_ENDPOINT_URL=https://s3.ap-southeast-1.wasabisys.com
WASABI_ACCESS_KEY_ID=your-wasabi-access-key
WASABI_SECRET_ACCESS_KEY=your-wasabi-secret-key
