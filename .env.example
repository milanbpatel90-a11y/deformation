# Copy this file to .env for local development.
# Generate a unique one-time setup token before the first startup:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENV=development
AUTH_BOOTSTRAP_TOKEN=
AUTH_DB_PATH=data/auth.sqlite3
AUTH_COOKIE_SECURE=false

# Local development generates and stores a private .auth_secret automatically.
# Production MUST set AUTH_SECRET_KEY to a unique random value (48+ random bytes).
AUTH_SECRET_KEY=

# Leave blank when the browser viewer and API are served from the same origin.
# For a separate trusted frontend, list exact origins separated by commas.
CORS_ALLOWED_ORIGINS=
