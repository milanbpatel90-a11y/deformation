    "frame": "Frame",
    "bridge": "Bridge",
    "left_temple": "LeftTemple",
    "right_temple": "RightTemple",
    "left_lens": "LeftLens",
    "right_lens": "RightLens",
    "left_rim": "LeftRim",
    "right_rim": "RightRim"
  },
  "empties": {
    "bridge": "Bridge_Center",
    "left_hinge": "Left_Hinge",
    "right_hinge": "Right_Hinge",
    "left_temple_tip": "Left_Temple_End",
    "right_temple_tip": "Right_Temple_End"
  },
  "bridge_width_mm": 17.2,
  "lens_width_mm": 53,
