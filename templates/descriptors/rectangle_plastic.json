    "right": { "part": "RightTemple", "empty": "Right_Hinge", "confidence": 1.0 }
  },
  "bridge": { "part": "Bridge", "empty": "Bridge_Center", "type": "keyhole" },
  "rim_loops": {
    "frame": { "part": "Frame", "confidence": 1.0 },
    "left_rim": { "part": "LeftRim", "confidence": 1.0 },
    "right_rim": { "part": "RightRim", "confidence": 1.0 }
  },
  "temple_pivots": {
    "left": { "part": "LeftTemple", "empty": "Left_Hinge" },
    "right": { "part": "RightTemple", "empty": "Right_Hinge" }
