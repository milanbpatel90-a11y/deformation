  "frame_width_mm": 140,
  "temple_length_mm": 145,
  "allow_bridge_scaling": true,
  "allow_frame_scaling": true,
  "allow_lens_scaling": true,
  "allow_temple_rotation": true,
  "allow_temple_translation": true,
  "allow_temple_scaling": false,
  "mirror_symmetry": true,
  "preserve_materials": true,
  "preserve_uvs": true,
  "deformation": {
    "bridge_weight": 1.0,
    "frame_weight": 0.8,
    "lens_weight": 0.7,
    "temple_weight": 1.0,
    "smooth_iterations": 10
  },
  "hinges": {
